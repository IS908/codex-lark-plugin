# Generated from src/config-schema.ts. Run: npm run generate:config
# Shell environment variables override values loaded from this file.

# === Credentials ===
LARK_APP_ID=
# Feishu/Lark application ID.
LARK_APP_SECRET=
# Feishu/Lark application secret.

# === Messaging ===
# LARK_CARD_FOOTER_METRICS_ENABLED=true # Append compact runtime metrics to generated card replies. Default: true.
# LARK_CARD_FOOTER_METRICS_TOKEN_USAGE_THRESHOLD=20000 # Token threshold for showing usage in card footers. Default: 20000.
# LARK_CODEX_EXEC_COMMAND=codex # Codex CLI command used for exec delivery. Default: codex.
# LARK_CODEX_EXEC_CWD= # Working directory for foreground Codex exec turns. Default: ~/.codex/channels/lark/codex-exec-workdir.
# LARK_CODEX_EXEC_IGNORE_USER_CONFIG=true # Prevent child exec turns from loading user Codex configuration. Default: true.
# LARK_CODEX_EXEC_MODEL= # Optional global model override for Codex exec. Default: (empty).
# LARK_CODEX_EXEC_PROFILE= # Optional Codex configuration profile. Default: (empty).
# LARK_CODEX_EXEC_SANDBOX=workspace-write # Sandbox mode passed to foreground Codex exec. Default: workspace-write.
# LARK_CODEX_EXEC_TIMEOUT_MS=600000 # Timeout for one foreground Codex exec run. Default: 600000.
# LARK_CODEX_EXEC_TOOL_TRACE=false # Write sanitized Codex tool execution traces locally. Default: false.
# LARK_CODEX_EXEC_TOOL_TRACE_MODE=compact # Local Codex tool trace detail level. Default: compact.
# LARK_CODEX_EXEC_TRACE_LOG= # Path of the local Codex tool trace log. Default: ~/.codex/channels/lark/logs/trace.log.
# LARK_CODEX_EXEC_USE_SESSIONS=true # Resume one Codex session per Feishu chat or thread. Default: true.
# LARK_CODEX_SESSION_RETENTION_DAYS=14 # Retention age for Codex exec session pointers. Default: 14.
# LARK_CODEX_SESSION_RETENTION_DRY_RUN=false # Preview Codex session cleanup without deleting records. Default: false.
# LARK_CODEX_SESSION_RETENTION_SCAN_INTERVAL_HOURS=24 # Interval for scanning expired Codex session pointers. Default: 24.
# LARK_CONTINUATION_ENABLED=true # Enable durable background continuation creation and execution. Default: true.
# LARK_CONTINUATION_MAX_ATTEMPTS=5 # Maximum attempts per continuation Job. Default: 5.
# LARK_CONTINUATION_MAX_CONCURRENCY=1 # Maximum concurrent continuation executions. Default: 1.
# LARK_CONTINUATION_MAX_RETRIES=3 # Retryable failures allowed within the attempt budget. Default: 3.
# LARK_CONTINUATION_MAX_TOTAL_MINUTES=30 # Maximum lifetime of one continuation Job. Default: 30.
# LARK_CONTINUATION_RETENTION_DAYS=30 # Days to retain terminal continuation details and artifacts. Default: 30.
# LARK_CONTINUATION_WORKING_ROOT= # Absolute authorized root for continuation working directories. Default: LARK_CODEX_EXEC_CWD.
# LARK_EXEC_PROGRESS_ENABLED=true # Enable bounded progress updates for long foreground turns. Default: true.
# LARK_EXEC_PROGRESS_MAX_CHARS=300 # Maximum characters in one progress message. Default: 300.
# LARK_EXEC_PROGRESS_MAX_MESSAGES=3 # Maximum progress messages per foreground turn. Default: 3.
# LARK_EXEC_PROGRESS_MIN_INTERVAL_MS=15000 # Minimum interval between progress messages. Default: 15000.
# LARK_EXEC_PROGRESS_POLL_INTERVAL_MS=250 # Parent-side progress side-channel polling interval. Default: 250.
# LARK_QUEUE_HANDLER_TIMEOUT_MS= # Per-thread queue timeout; zero disables it and positive values are raised above the exec timeout. Default: LARK_CODEX_EXEC_TIMEOUT_MS + 60000.
# LARK_REPLY_OBLIGATION_TIMEOUT_MS= # Maximum wait for a visible reply or defer result. Default: max(60000, LARK_CODEX_EXEC_TIMEOUT_MS + 60000).
# LARK_SESSION_HEALTH_COOLDOWN_MS=1800000 # Initial cooldown between session health nudges. Default: 1800000.
# LARK_SESSION_HEALTH_ENABLED=false # Enable owner nudges for long-running Codex sessions. Default: false.
# LARK_SESSION_HEALTH_IDLE_DELAY_MS=30000 # Idle delay before checking session health gates. Default: 30000.
# LARK_SESSION_HEALTH_MAX_COOLDOWN_MS=21600000 # Maximum exponential session health cooldown. Default: 21600000.
# LARK_SESSION_HEALTH_MAX_NUDGES=3 # Maximum health nudges per session episode. Default: 3.
# LARK_SESSION_HEALTH_PROMPT_BYTES_THRESHOLD=524288 # Prompt-byte threshold for a session health nudge. Default: 524288.
# LARK_SESSION_HEALTH_TOKEN_THRESHOLD=160000 # Reported token threshold for a session health nudge. Default: 160000.
# LARK_SESSION_HEALTH_TURN_THRESHOLD=80 # Session turn threshold for a health nudge. Default: 80.
# LARK_TEXT_CHUNK_LIMIT=4000 # Maximum characters per text message chunk. Default: 4000.

# === Acknowledgement ===
# LARK_ACK_EMOJI=MeMeMe # Emoji reaction added when a message is received. Default: MeMeMe.
# LARK_BOT_MESSAGE_TRACKER_SIZE=500 # Maximum bot message IDs retained for routing and mutation guards. Default: 500.
# LARK_DOC_COMMENT_ACK_EMOJI=THUMBSUP # Persistent reaction for inbound document-comment mentions. Default: THUMBSUP.

# === Reliability ===
# LARK_DOWNLOAD_MAX_BYTES=26214400 # Maximum bytes accepted for one downloaded attachment. Default: 26214400.
# LARK_DOWNLOAD_TIMEOUT_MS=60000 # Attachment and image download timeout. Default: 60000.
# LARK_FEISHU_API_RETRY_ATTEMPTS=3 # Attempts for retryable Feishu API failures. Default: 3.
# LARK_FEISHU_API_RETRY_BASE_DELAY_MS=250 # Base delay for exponential Feishu API retries. Default: 250.
# LARK_FEISHU_API_TIMEOUT_MS=30000 # Timeout for one Feishu API call. Default: 30000.

# === CronJob ===
# LARK_CRON_SCAN_INTERVAL=60 # Cron schedule scan interval in seconds. Default: 60.
# LARK_CRON_TIMEZONE= # Default IANA timezone for new CronJobs and local logs. Default: system timezone.

# === Memory ===
# LARK_INACTIVITY_HOURS=3 # Inactivity threshold before flushing buffered conversation memory. Default: 3.
# LARK_MAX_EPISODE_BYTES=65536 # Maximum bytes persisted in one episode file. Default: 65536.
# LARK_MAX_EPISODE_FILES_PER_SCOPE=200 # Maximum episode files retained per chat or thread scope. Default: 200.
# LARK_MAX_EPISODE_SCOPE_BYTES=10485760 # Maximum total episode bytes retained per scope. Default: 10485760.
# LARK_MAX_SEARCH_RESULTS=2 # Maximum episode search results injected into a turn. Default: 2.
# LARK_MEMORY_DEDUP_WINDOW_MS=1800000 # Window for suppressing unchanged memory blocks. Default: 1800000.
# LARK_MIN_SEARCH_SCORE=0.3 # Minimum relevance score for episode search results. Default: 0.3.
# LARK_PROFILE_DISTILLATION_COOLDOWN_MS=86400000 # Per-user cooldown between profile distillation dispatches. Default: 86400000.
# LARK_PROFILE_DISTILLATION_ENABLED=false # Enable profile distillation from recent episodes. Default: false.
# LARK_PROFILE_DISTILLATION_MAX_EPISODES=5 # Maximum recent episodes included in one distillation prompt. Default: 5.
# LARK_PROFILE_DISTILLATION_MIN_EPISODES=3 # Minimum episodes required before profile distillation. Default: 3.

# === Identity ===
# LARK_IDENTITY_SESSION_MAX_ENTRIES=5000 # Maximum server-derived caller identity session entries. Default: 5000.
# LARK_IDENTITY_SESSION_TTL_MS= # Lifetime of server-derived caller identity sessions. Default: max(2h, LARK_INACTIVITY_HOURS x 2h).
# LARK_OWNER_OPEN_ID= # Immutable operator identity and terminal-skill trust root. Default: (empty).

# === Privacy ===
# LARK_AUDIT_LOG= # Path of the append-only sensitive-operation audit log. Default: ~/.codex/channels/lark/logs/audit.log.

# === Quoted cards ===
# LARK_CARD_CONTEXT_CACHE_SIZE=200 # Maximum cached parent or root card contexts. Default: 200.
# LARK_CARD_CONTEXT_CACHE_TTL_MS=1800000 # Lifetime of fetched card context cache entries. Default: 1800000.
# LARK_QUOTED_CARD_USER_FETCH_COMMAND=lark-cli # lark-cli command used for quoted-card user fallback. Default: lark-cli.
# LARK_QUOTED_CARD_USER_FETCH_ENABLED=true # Allow user-identity fallback when bot card hydration fails. Default: true.
# LARK_QUOTED_CARD_USER_FETCH_MAX_BYTES=262144 # Maximum output bytes captured from quoted-card user fallback. Default: 262144.
# LARK_QUOTED_CARD_USER_FETCH_TIMEOUT_MS=10000 # Timeout for quoted-card user-identity fallback. Default: 10000.
# LARK_QUOTED_CONTEXT_MAX_BYTES=12000 # UTF-8 byte budget for hydrated quoted-message context. Default: 12000.
# LARK_QUOTED_CONTEXT_MAX_DEPTH=4 # Maximum quoted-message chain depth hydrated for Codex. Default: 4.

# === Resource governance ===
# LARK_CHAT_TYPE_CACHE_SIZE=1000 # Maximum cached Feishu chat types. Default: 1000.
# LARK_DEBUG_LOG= # Path of the local runtime debug log. Default: ~/.codex/channels/lark/logs/debug.log.
# LARK_INBOX_MAX_AGE_HOURS=168 # Maximum age of downloaded inbox files during cleanup. Default: 168.
# LARK_INBOX_MAX_BYTES=209715200 # LRU byte cap for downloaded inbox files. Default: 209715200.
# LARK_LATEST_MESSAGE_TRACKER_SIZE=1000 # Maximum latest-inbound-message tracker entries. Default: 1000.
# LARK_LOG_ARCHIVE_RETENTION_MONTHS=6 # Number of monthly log archive directories retained. Default: 6.
# LARK_LOG_MAX_BYTES=5242880 # Log size threshold before rotation. Default: 5242880.
# LARK_LOG_MAX_FILES=5 # Number of rotated log files retained. Default: 5.
# LARK_NAME_CACHE_SIZE=1000 # Maximum cached user and chat display names. Default: 1000.
