{
  "name": "codex-lark-plugin",
  "version": "2.12.2",
  "description": "Codex channel plugin for Feishu/Lark — chat with Codex through Feishu with local-file memory and scheduled jobs",
  "keywords": [
    "codex",
    "mcp",
    "feishu",
    "lark",
    "im",
    "bot",
    "memory",
    "scheduled-jobs"
  ],
  "author": "IS908 <kevinchen0635@gmail.com> (https://github.com/IS908)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IS908/codex-lark-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/IS908/codex-lark-plugin/issues"
  },
  "homepage": "https://github.com/IS908/codex-lark-plugin#readme",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "stop": "node --import tsx src/stop.ts",
    "doctor": "node --import tsx src/configure-doctor-cli.ts",
    "build": "tsc && node scripts/build-runtime-bundles.js --target . && node scripts/build-runtime-bundles.js --target plugins/lark",
    "build:plugin": "node scripts/build-runtime-bundles.js --target plugins/lark",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/test.sh",
    "smoke:sdk": "node --import tsx scripts/sdk-channel-scaffold-smoke.ts && node --import tsx scripts/sdk-identity-smoke.ts && node --import tsx scripts/sdk-message-parity-smoke.ts && node --import tsx scripts/sdk-outbound-parity-smoke.ts && node --import tsx scripts/lark-transport-smoke.ts && node --import tsx scripts/sdk-runtime-smoke.ts && node --import tsx scripts/sdk-rollout-doc-smoke.ts",
    "check:release-version": "node scripts/check-release-version.js",
    "check:runtime-bundle-sync": "node scripts/build-runtime-bundles.js --target plugins/lark --check",
    "check:skill-mirror": "node --import tsx scripts/skill-mirror-sync-smoke.ts",
    "generate:config": "node --import tsx scripts/generate-config-artifacts.ts",
    "check:config-artifacts": "node --import tsx scripts/generate-config-artifacts.ts --check",
    "check:architecture": "node scripts/architecture-check.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@larksuite/channel": "^0.2.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "axios": "1.18.1",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "hono": "4.12.32",
    "ip-address": "10.2.0",
    "protobufjs": "7.6.5",
    "qs": "6.15.2",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "Apache-2.0"
}
